    {
      "parameters": {
        "jsCode": "// Pega os dados calculados no nó \"calculates the times\"\nconst metrics = $('calculates the times').first().json;\n\n// Pega a meta de SLA buscada no nó anterior\nconst target = $input.first().json;\n\n// Compara o FRT com o limite em segundos\nconst slaMet = metrics.first_response_time_seconds <= target.threshold_seconds;\n\n// Retorna tudo junto: os dados calculados + o resultado da comparação\nreturn [{\n  json: {\n    ...metrics,\n    sla_met: slaMet,\n    sla_threshold_seconds: target.threshold_seconds\n  }\n}];"
      },

      "name": "Get the conversation categories",
      "credentials": {
        "supabaseApi": {
          "id": "KrJJTonTudWxCF8w",
          "name": "Supabase - SleekFlow - support-dashboard"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pega a resposta do Gemini\nconst geminiResponse = $input.first().json;\nconst rawText = geminiResponse.candidates[0].content.parts[0].text.trim();\n\n// Converte pra número\nconst categoryId = parseInt(rawText, 10);\n\n// Busca a lista de categorias (guardada desde o nó \"Build Classifier Input\")\nconst categoryLookup = $('Code: Build Classifier Input').first().json.category_lookup;\n\n// Valida se o ID retornado realmente existe na lista de categorias\nconst matchedCategory = categoryLookup.find(cat => cat.category_id === categoryId);\n\nif (!matchedCategory) {\n  // Caso a IA retorne algo inesperado (raro, mas precisamos nos proteger)\n  return [{\n    json: {\n      category_id: null,\n      category_name: null,\n      classification_error: `Resposta inesperada da IA: \"${rawText}\"`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    category_id: matchedCategory.category_id,\n    category_name: matchedCategory.category_name\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

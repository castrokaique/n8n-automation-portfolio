      "name": "Get Messages in fact_messages",
      "credentials": {
        "supabaseApi": {
          "id": "KrJJTonTudWxCF8w",
          "name": "Supabase - SleekFlow - support-dashboard"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pega todas as mensagens que vieram do nó anterior (Get Messages)\nconst messages = $input.all().map(item => item.json);\n\n// Ordena por sent_at, do mais antigo pro mais recente (segurança extra)\nmessages.sort((a, b) => new Date(a.sent_at) - new Date(b.sent_at));\n\n// Variáveis de controle\nlet pendingCustomerTimestamp = null;\nlet responseIntervals = [];\nlet lastAgentId = null;\n\nfor (const msg of messages) {\n  const sentAt = new Date(msg.sent_at);\n  if (msg.sender_type === 'customer') {\n    if (pendingCustomerTimestamp === null) {\n      pendingCustomerTimestamp = sentAt;\n    }\n  } else {\n    if (pendingCustomerTimestamp !== null) {\n      const diffSeconds = (sentAt - pendingCustomerTimestamp) / 1000;\n      responseIntervals.push(diffSeconds);\n      pendingCustomerTimestamp = null;\n    }\n    lastAgentId = msg.agent_id;\n  }\n}\n\nconst firstResponseTimeSeconds = responseIntervals.length > 0\n  ? Math.round(responseIntervals[0])\n  : null;\n\nconst averageResponseTimeSeconds = responseIntervals.length > 0\n  ? Math.round(\n      (responseIntervals.reduce((sum, val) => sum + val, 0) / responseIntervals.length) * 100\n    ) / 100\n  : null;\n\nconst firstCustomerMessage = messages.find(m => m.sender_type === 'customer');\nconst openedAt = firstCustomerMessage ? new Date(firstCustomerMessage.sent_at) : null;\nconst closedAt = new Date();\n\nconst averageHandleTimeSeconds = openedAt\n  ? Math.round((closedAt - openedAt) / 1000)\n  : null;\n\n// Verifica os tipos de remetente presentes na conversa\nconst hadHumanMessage = messages.some(msg => msg.sender_type === 'human');\nconst hadAiMessage = messages.some(msg => msg.sender_type === 'ai');\n\nlet conversationType;\nif (hadHumanMessage && hadAiMessage) {\n  conversationType = 'mixed';\n} else if (hadHumanMessage) {\n  conversationType = 'human';\n} else if (hadAiMessage) {\n  conversationType = 'ai';\n} else {\n  conversationType = null;\n}\n\nreturn [{\n  json: {\n    protocol_number: messages[0]?.protocol_number || null,\n    sleekflow_conversation_id: messages[0]?.sleekflow_conversation_id || null,\n    opened_at: openedAt ? openedAt.toISOString() : null,\n    closed_at: closedAt.toISOString(),\n    first_response_time_seconds: firstResponseTimeSeconds,\n    average_response_time_seconds: averageResponseTimeSeconds,\n    average_handle_time_seconds: averageHandleTimeSeconds,\n    agent_id: lastAgentId,\n    message_count: messages.length,\n    conversation_type: conversationType\n  }\n}];"
      },
